{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosticOutput",
  "type": "object",
  "required": [
    "schema_version",
    "prompt_version",
    "request_id",
    "problem_summary",
    "asset_context",
    "hypotheses",
    "evidence",
    "recommended_checks",
    "safety_notes",
    "abstain",
    "abstention_reason",
    "escalation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "prompt_version": {"type": "string"},
    "request_id": {"type": "string"},
    "problem_summary": {"type": "string"},
    "asset_context": {
      "type": "object",
      "required": ["asset_type", "operating_state", "symptoms"],
      "properties": {
        "asset_type": {"type": "string"},
        "operating_state": {"type": "string"},
        "symptoms": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["failure_mode", "rationale", "supporting_evidence", "contradicting_evidence", "confidence"],
        "properties": {
          "failure_mode": {"type": "string"},
          "rationale": {"type": "string"},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}},
          "contradicting_evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "evidence_record.json"}},
    "recommended_checks": {"type": "array", "items": {"type": "string"}},
    "safety_notes": {"type": "array", "items": {"type": "string"}},
    "abstain": {"type": "boolean"},
    "abstention_reason": {"type": ["string", "null"]},
    "escalation": {"$ref": "escalation_record.json"}
  },
  "additionalProperties": false
}